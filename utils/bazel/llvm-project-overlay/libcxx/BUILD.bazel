filegroup(
    name = "top_level_headers",
    srcs = glob(
        [
            "include/*",
        ],
        exclude = [
            "include/**/CMakeLists.txt",
            "include/__config_site.in",
        ],
    ) + [
        ":__assertion_handler_gen",
        ":__config_site_gen",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "headers",
    hdrs = glob(
        [
            "include/**/*",
            "src/include/**/*",
        ],
        exclude = [
            "include/**/CMakeLists.txt",
            "include/__config_site.in",
        ],
    ) + [
        ":__assertion_handler_gen",
        ":__config_site_gen",
    ],
    includes = [
        "include",
        "src",
        "src/include",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    srcs = glob(["src/**/*"]),
    visibility = ["//visibility:public"],
)

